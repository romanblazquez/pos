{
  "name": "retail-os",
  "version": "0.1.0",
  "private": true,
  "description": "Retail OS — modular, offline-first Retail Operating System (POS-first, ERP-ready)",
  "license": "UNLICENSED",
  "main": "apps/desktop-shell/out/main/main.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "node tools/scripts/dev.mjs",
    "dev:pos:desktop": "node tools/scripts/dev.mjs --standalone=pos",
    "dev:pos": "vite --config apps/pos/vite.config.mts",
    "dev:shell": "electron-vite dev --config apps/desktop-shell/electron.vite.config.mts",
    "dev:customer-display": "vite --config apps/customer-display/vite.config.mts",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "build": "pnpm build:pos && pnpm build:shell",
    "build:pos": "vite build --config apps/pos/vite.config.mts",
    "build:shell": "electron-vite build --config apps/desktop-shell/electron.vite.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "graph": "nx graph",
    "db:generate": "prisma generate --schema libs/data/db-postgres/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema libs/data/db-postgres/prisma/schema.prisma",
    "db:push": "prisma db push --schema libs/data/db-postgres/prisma/schema.prisma",
    "db:studio": "prisma studio --schema libs/data/db-postgres/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema libs/data/db-postgres/prisma/schema.prisma",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f odoo odoo-db",
    "infra:ps": "docker compose ps",
    "infra:reset": "docker compose down -v",
    "dev:api": "DATABASE_URL=postgresql://retail:retail@localhost:5432/retail_os?schema=public tsx --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "dev:bgg-scraper": "tsx --tsconfig apps/bgg-scraper/tsconfig.json apps/bgg-scraper/src/main.ts",
    "dev:web": "concurrently --kill-others-on-fail --names api,market,seller,admin --prefix-colors cyan,green,yellow,magenta \"pnpm dev:api\" \"pnpm dev:marketplace\" \"pnpm dev:seller-portal\" \"pnpm dev:admin\"",
    "dev:marketplace": "vite --config apps/marketplace/vite.config.mts",
    "dev:seller-portal": "vite --config apps/seller-portal/vite.config.mts",
    "dev:admin": "vite --config apps/admin-console/vite.config.mts",
    "build:marketplace": "vite build --config apps/marketplace/vite.config.mts",
    "build:seller-portal": "vite build --config apps/seller-portal/vite.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.62.0",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.7.0",
    "bullmq": "^5.78.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.0",
    "dockview": "^1.13.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.18.0",
    "nanoid": "^5.0.9",
    "openai": "^6.43.0",
    "playwright": "^1.61.0",
    "playwright-core": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.8.0",
    "typesense": "^3.0.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "nx": "^22.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
