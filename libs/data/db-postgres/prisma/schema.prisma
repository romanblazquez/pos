}

// ─── Commerce markets (public marketplace) ───────────────────────────────────
//
// A CommerceMarket is the PUBLIC, consumer-facing market of juegospedia.com: a
// country whose shoppers get their own eligible sellers, canonical currency, tax
// treatment, ranking and analytics dimension.
//
// Deliberately NOT named `Market`. Two other models already claim that word:
// `Marketplace` is an EXTERNAL marketplace (Amazon, MercadoLibre) that we ingest
// offers from, and `TenantMarket` is retail-os tenant configuration on the
// POS/ERP side of this monorepo. Collapsing three concepts into one noun would
// make a 147-model schema unreadable. See docs/adr/0007-language-market-separation.md.
model CommerceMarket {
  id                String                 @id @default(cuid())
  /// Uppercase market code, conventionally the ISO country code (MX, ES, US).
  code              String                 @unique
  name              String
  countryId         String
  countryCode       String                 @db.Char(2)
  /// The market's native commercial currency. Offers keep their own native
  /// currency; this is what SEO-visible comparison and JSON-LD are priced in.
  canonicalCurrency String                 @db.Char(3)
  /// Display currencies a user may switch to. Presentation only — never changes
  /// the canonical URL, hreflang or sitemap.
  displayCurrencies String[]
  defaultLanguage   String
  timezone          String
  /// 'inclusive' | 'exclusive' — whether displayed prices include tax.
  taxMode           String                 @default("inclusive")
  /// Offers older than this are excluded from comparison as stale.
  offerFreshnessHours Int                  @default(72)
  active            Boolean                @default(false)
  /// Whether this market's pages may be indexed. Independent of `active` so a
  /// market can be launched to users before it is opened to crawlers.
  indexable         Boolean                @default(false)
  sortOrder         Int                    @default(100)
  seoTitle          String?
  seoDescription    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  country           Country                @relation(fields: [countryId], references: [id], onDelete: Restrict)
  locales           CommerceMarketLocale[]
  tenantMarkets     TenantMarket[]
  sellerMarkets     SellerMarket[]

  @@index([active, indexable, sortOrder])
  @@index([countryCode, active])
  @@map("commerce_market")
}

/// One language × market combination, and the URL prefix that serves it.
/// `/es-mx` and `/en-mx` are two locales of the single MX market.
model CommerceMarketLocale {
  id           String         @id @default(cuid())
  marketId     String
  languageCode String
  /// BCP-47 tag, e.g. es-MX. Stored canonically cased for hreflang output.
  localeCode   String
  /// Lowercase URL prefix, e.g. es-mx. Unique across all markets.
  urlPrefix    String         @unique
  active       Boolean        @default(false)
  indexable    Boolean        @default(false)
  /// The locale served when a market is resolved without an explicit language.
  isDefault    Boolean        @default(false)
  seoTitle     String?
  seoDescription String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  market       CommerceMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, languageCode])
  @@index([active, indexable])
  @@map("commerce_market_locale")
}

/// Append-only FX observation. Rates are NEVER updated or deleted: a converted
/// price shown to a user must stay explainable for as long as the price history
/// that references it, so each conversion records the snapshot it used.
model ExchangeRateSnapshot {
  id            String   @id @default(cuid())
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  /// Units of quoteCurrency per 1 baseCurrency. High precision: some pairs in
  /// scope (e.g. ARS) carry large magnitudes with meaningful minor digits.
  rate          Decimal  @db.Decimal(20, 10)
  provider      String
  effectiveAt   DateTime
  fetchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, provider, effectiveAt])
  @@index([baseCurrency, quoteCurrency, effectiveAt(sort: Desc)])
  @@map("exchange_rate_snapshot")
}

/// Platform cashback balance scoped to ONE market, in that market's currency.
///
/// Credits are a liability the platform owes, so they cannot be a single global
/// integer: credits earned on an MXN purchase must never be redeemable against
/// an ARS one. Doing so would make the platform absorb the FX spread, and would
/// move value across a tax border with no corresponding transaction — the same
/// reason `StoreCredit` is scoped per seller rather than pooled.
///
/// Redemption is only permitted when the market, the currency and the payment
/// rail all match the market the credit was earned in.
model MarketCredit {
  id           String         @id @default(cuid())
  walletId     String
  /// Market code (CommerceMarket.code), e.g. MX.
  marketCode   String
  /// Always the market's canonical currency; denormalized so a balance can
  /// never be read without the money it is denominated in.
  currency     String         @db.Char(3)
  balanceMinor Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  wallet       CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, marketCode])
  @@index([walletId])
  @@map("market_credit")
}
