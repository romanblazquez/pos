// Retail OS — central PostgreSQL schema (multi-tenant master data, reporting,
// sync ingestion, provider connections, terminal assignments, and onboarding).
//
// Multi-tenancy: every row is scoped by tenantId (row-level isolation now;
// schema-per-tenant or RLS policies are a roadmap hardening step).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────
model Tenant {
  id                    String               @id @default(cuid())
  name                  String
  legalName             String?
  country               String               @default("MX")
  taxIdentifier         String?
  currency              String               @default("MXN")
  timezone              String               @default("America/Mexico_City")
  onboardingCompleted   Boolean              @default(false)
  createdAt             DateTime             @default(now())
  stores                Store[]
  products              Product[]
  users                 User[]
  providerConnections   ProviderConnection[]
  terminalAssignments   TerminalAssignment[]
  onboardingState       OnboardingState?
  canonicalIntegrations SellerIntegration[]
  affiliateAccounts     AffiliateAccount[]
  seoPages              SeoPage[]
  canonicalMarkets      TenantMarket[]
}

model Store {
  id                  String               @id @default(cuid())
  tenantId            String
  name                String
  address             String?
  storeType           String               @default("retail")
  currency            String               @default("MXN")
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  devices             Device[]
  sales               Sale[]
  terminalAssignments TerminalAssignment[]

  @@index([tenantId])
}

model Device {
  id           String   @id
  tenantId     String
  storeId      String
  label        String
  status       String   @default("pending") // pending | trusted | revoked
  publicKeyFp  String?
  registeredAt DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id])

  @@index([tenantId, storeId])
}

model User {
  id       String   @id @default(cuid())
  tenantId String
  email    String
  name     String
  roles    String[] // cashier | supervisor | store_manager | admin
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
}

/// Global authentication identity. Domain profiles (customer, seller, tenant user)
/// link to this record instead of treating an email address as an authorization key.
model AuthPrincipal {
  id              String                   @id @default(cuid())
  email           String
  normalizedEmail String                   @unique
  displayName     String?
  status          String                   @default("active") // active | suspended | disabled
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  identities      FederatedIdentity[]
  sessions        AuthSession[]
  customer        MktCustomer?
  seller          Seller?
  adminMembership PlatformAdminMembership?
  auditEvents     AuditEvent[]

  @@index([status])
}

/// Stable external identity. Google `sub`, not email, is the provider identifier.
model FederatedIdentity {
  id              String        @id @default(cuid())
  principalId     String
  provider        String
  providerSubject String
  providerEmail   String?
  emailVerified   Boolean       @default(false)
  hostedDomain    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  principal       AuthPrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([principalId])
}

/// Server-side refresh session. Only a SHA-256 hash of the refresh credential is stored.
model AuthSession {
  id                  String        @id @default(cuid())
  principalId         String
  familyId            String
  role                String
  audience            String
  refreshTokenHash    String        @unique
  expiresAt           DateTime
  lastUsedAt          DateTime      @default(now())
  revokedAt           DateTime?
  replacedBySessionId String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime      @default(now())
  principal           AuthPrincipal @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@index([principalId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/// One-time challenge binding a Google ID token nonce to the initiating app.
model AuthChallenge {
  id         String    @id @default(cuid())
  app        String
  stateHash  String    @unique
  nonceHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// One-time state for third-party OAuth callbacks. The state value itself is never stored.
model OAuthTransaction {
  id           String    @id @default(cuid())
  provider     String
  ownerId      String
  stateHash    String    @unique
  codeVerifier String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([provider, ownerId])
  @@index([expiresAt])
}

/// Explicit allowlist for the platform administration trust boundary.
model PlatformAdminMembership {
  id          String         @id @default(cuid())
  email       String         @unique
  principalId String?        @unique
  role        String         @default("platform_admin")
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  principal   AuthPrincipal? @relation(fields: [principalId], references: [id])

  @@index([status])
}

/// Append-only security and privileged-action audit trail.
model AuditEvent {
  id               String         @id @default(cuid())
  actorPrincipalId String?
  sessionId        String?
  action           String
  targetType       String?
  targetId         String?
  outcome          String         @default("success")
  correlationId    String?
  ipAddress        String?
  metadata         Json?
  createdAt        DateTime       @default(now())
  actor            AuthPrincipal? @relation(fields: [actorPrincipalId], references: [id])

  @@index([actorPrincipalId, createdAt])
  @@index([action, createdAt])
  @@index([correlationId])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────
model Product {
  id              String     @id @default(cuid())
  tenantId        String
  sku             String
  name            String
  barcode         String?
  category        String
  photoUrl        String?
  priceMinorUnits Int
  currency        String     @default("MXN")
  taxRatePercent  Float      @default(16)
  trackInventory  Boolean    @default(true)
  active          Boolean    @default(true)
  // Provenance: where this product originally came from.
  // null = created natively in Retail OS.
  sourceType      String? // 'tiendanube' | 'shopify' | 'csv' | 'api'
  sourceId        String? // external product id in the source system
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  saleLines       SaleLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, sourceType, sourceId])
}

// ─── Sales ────────────────────────────────────────────────────────────────────
model Sale {
  id              String     @id
  tenantId        String
  storeId         String
  deviceId        String
  customerId      String?
  status          String
  currency        String
  totalMinorUnits Int
  taxMinorUnits   Int
  snapshot        Json
  committedAt     DateTime
  ingestedAt      DateTime   @default(now())
  store           Store      @relation(fields: [storeId], references: [id])
  lines           SaleLine[]
  payments        Payment[]

  @@index([tenantId, storeId, committedAt])
}

model SaleLine {
  id             String   @id @default(cuid())
  saleId         String
  productId      String?
  name           String
  sku            String?
  quantity       Float
  unitPriceMinor Int
  discountMinor  Int      @default(0)
  taxRatePercent Float
  lineTotalMinor Int
  sale           Sale     @relation(fields: [saleId], references: [id])
  product        Product? @relation(fields: [productId], references: [id])

  @@index([saleId])
}

model Payment {
  id            String                @id
  saleId        String
  tenantId      String
  provider      String
  method        String
  amountMinor   Int
  status        String
  providerRef   String?
  createdAt     DateTime              @default(now())
  sale          Sale                  @relation(fields: [saleId], references: [id])
  webhookEvents PaymentWebhookEvent[]

  @@index([saleId])
  @@index([tenantId])
}

// ─── Payment providers ───────────────────────────────────────────────────────
/// OAuth and credential storage per merchant–provider pair.
/// Access tokens are stored encrypted; the plaintext never leaves the API process.
model ProviderConnection {
  id                    String    @id @default(cuid())
  tenantId              String
  provider              String // 'mercadopago_point' | 'codi' | 'stripe_terminal' | …
  mode                  String    @default("production") // production | development
  status                String    @default("pending_oauth") // active | expired | error | pending_oauth | disconnected
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  clientId              String?
  scope                 String?
  providerAccountId     String? // MP merchant_id after OAuth
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, mode])
  @@index([tenantId])
}

/// Maps a physical/virtual terminal to a store.
model TerminalAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  storeId       String
  provider      String
  terminalId    String
  terminalName  String
  terminalModel String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  store         Store    @relation(fields: [storeId], references: [id])

  @@unique([tenantId, provider, terminalId])
  @@index([tenantId, storeId])
}

/// Append-only log of all inbound provider webhooks for audit and replay.
model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  tenantId        String
  provider        String
  providerEventId String?
  paymentId       String?
  rawPayload      Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@index([tenantId, provider])
  @@index([providerEventId])
}

// ─── Onboarding ───────────────────────────────────────────────────────────────
/// Persists onboarding wizard progress so it survives restarts and can be resumed.
model OnboardingState {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  currentStep    String
  completedSteps String[]
  data           Json
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

// ─── Sync idempotency ─────────────────────────────────────────────────────────
/// Server-side idempotency ledger so re-delivered outbox messages are no-ops.
model IngestionKey {
  key        String   @id
  tenantId   String
  saleId     String
  receivedAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// MARKETPLACE — board game comparison & affiliate marketplace layer
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Sellers ──────────────────────────────────────────────────────────────────
model Seller {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  email                 String                 @unique
  phone                 String?
  country               String                 @default("MX")
  timezone              String                 @default("America/Mexico_City")
  logoUrl               String?
  description           String?
  // 'tiendanube' | 'shopify' | 'mercadolibre' | 'woocommerce' | 'odoo' | 'csv' | 'manual' | 'platform'
  connectorType         String?
  connectorConfig       Json? // encrypted at app layer before persisting
  tier                  String                 @default("starter") // starter | growth | pro | platform
  status                String                 @default("pending") // pending | active | suspended | churned
  commissionRate        Decimal                @default(0.03) @db.Decimal(5, 4)
  passwordHash          String?
  emailVerified         Boolean                @default(false)
  verifyToken           String?                @unique
  authPrincipalId       String?                @unique
  authPrincipal         AuthPrincipal?         @relation(fields: [authPrincipalId], references: [id])
  onboardingStep        String? // current step if onboarding not complete
  onboardingData        Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  listings              Listing[]
  orders                MarketplaceOrder[]
  score                 SellerScore?
  syncLogs              ConnectorSyncLog[]
  mpConnection          SellerMpConnection?
  rewardConfig          SellerRewardConfig?
  storeCredits          StoreCredit[]
  productMappings       SellerProductMapping[]
  canonicalIntegrations SellerIntegration[]
  sourceProducts        SellerSourceProduct[]
  canonicalOffers       SellerOfferCurrent[]
  affiliateAccounts     AffiliateAccount[]
  taxProfiles           TaxProfile[]
  returnPolicies        ReturnPolicy[]
  coupons               Coupon[]
  cashbackRules         CashbackRule[]
  sponsoredPlacements   SponsoredPlacement[]
  affiliateClicks       AffiliateClickEvent[]
  conversions           ConversionEvent[]
  canonicalMarkets      SellerMarket[]

  @@index([status])
  @@index([connectorType])
}

/// Per-seller MercadoPago OAuth connection for marketplace split payments.
/// encryptedCreds holds { accessToken, refreshToken, expiresAt } encrypted with
/// AES-256-GCM (same credential-crypto.ts used for connector creds).
model SellerMpConnection {
  id             String   @id @default(cuid())
  sellerId       String   @unique
  merchantId     String // MP user_id (string form of numeric seller ID)
  scope          String?
  encryptedCreds Json // { _enc: "iv:tag:ciphertext" }
  connectedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  seller         Seller   @relation(fields: [sellerId], references: [id])
}

model SellerScore {
  id                  String   @id @default(cuid())
  sellerId            String   @unique
  fulfillmentRate     Float    @default(1.0) // 0–1: % orders fulfilled on time
  cancellationRate    Float    @default(0.0) // 0–1: % orders cancelled by seller
  stockAccuracy       Float    @default(1.0) // 0–1: stock shown vs actual at order time
  responseTimeHours   Float    @default(24.0) // avg hours to confirm/reject order
  customerSvcScore    Float    @default(5.0) // 1–5
  catalogCompleteness Float    @default(0.5) // 0–1: % listings with full data
  integrationHealth   Float    @default(1.0) // 0–1: recent sync success rate
  compositeScore      Float    @default(0.5) // weighted aggregate, recalculated hourly
  scoredAt            DateTime @default(now())
  seller              Seller   @relation(fields: [sellerId], references: [id])
}

// ─── Marketplace Products (canonical, cross-seller) ───────────────────────────
model MktProduct {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  description     String?
  images          String[]
  bggId           String?                @unique // BoardGameGeek ID — primary dedup anchor
  category        String                 @default("board-game")
  publisher       String?
  publisherId     String?
  designer        String?
  yearPublished   Int?
  minPlayers      Int?
  maxPlayers      Int?
  minAge          Int?
  playTimeMinutes Int?
  language        String?
  edition         String?
  condition       String                 @default("new") // new | used | damaged
  tags            String[]
  // 'verified' = manually confirmed; 'pending' = auto-imported, needs review; 'duplicate' = merged
  canonicalStatus String                 @default("pending")
  bggRating       Float?
  bggWeight       Float? // complexity 1–5
  bggRank         Int? // overall rank from BGG's daily ranks dump
  bggUsersRated   Int?
  isExpansion     Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  listings        Listing[]
  sellerMappings  SellerProductMapping[]
  shelfItems      ShelfItem[]
  bggEnrichment   BggEnrichmentState?
  publisherEntity Publisher?             @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  categories      MktProductCategory[]
  availabilityRequests ProductAvailabilityRequest[]

  @@index([category])
  @@index([publisherId])
  @@index([canonicalStatus])
  @@index([bggId])
  @@index([bggRank])
}

// ─── Listings (seller × product × price × stock) ─────────────────────────────
// Durable checkpoint for the long-running BGG enrichment worker. Keeping this
// separate from MktProduct prevents transient scraper failures from becoming
// catalog data and lets a restarted worker resume without re-scraping successes.
model BggEnrichmentState {
  productId         String     @id
  bggId             String     @unique
  status            String     @default("pending") // pending | running | retry | succeeded | skipped | failed
  attempts          Int        @default(0)
  lastError         String?
  nextRetryAt       DateTime?
  scrapedAt         DateTime?
  imageDownloadedAt DateTime?
  translatedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  product           MktProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@map("bgg_enrichment_state")
}

model Listing {
  id              String                 @id @default(cuid())
  sellerId        String
  productId       String
  sellerSku       String?
  sellerProductId String? // ID in the seller's own system
  sellerUrl       String?
  priceMinorUnits Int // price in minor currency units (centavos)
  currency        String                 @default("MXN")
  condition       String                 @default("new")
  stock           Int                    @default(0)
  // 'in_stock' | 'low_stock' | 'out_of_stock' | 'unknown'
  stockStatus     String                 @default("unknown")
  stockConfidence Float                  @default(0.5) // 0–1: based on sync recency + accuracy history
  rankScore       Float                  @default(0.0) // composite, recalculated hourly
  scoreBreakdown  Json? // per-dimension scores for explainability
  lastSyncedAt    DateTime?
  active          Boolean                @default(true)
  seller          Seller                 @relation(fields: [sellerId], references: [id])
  product         MktProduct             @relation(fields: [productId], references: [id])
  deliveryOptions DeliveryOption[]
  orderLines      MarketplaceOrderLine[]
  promos          ListingPromo[]
  mapping         SellerProductMapping?

  @@unique([sellerId, sellerSku])
  @@index([productId, rankScore])
  @@index([sellerId, active])
  @@index([stockStatus])
}

/// Per-seller-SKU mapping cache AND staging queue for matching a seller's raw
/// synced items to the master MktProduct catalog. One row per (sellerId, externalKey).
/// Lifecycle: pending_review (ambiguous/no match) -> [seller acts] -> manual_matched | escalated | rejected
///            escalated -> [admin acts] -> manual_matched | rejected
///            auto_matched / manual_matched rows ARE the fast-path cache for future syncs.
model SellerProductMapping {
  id              String      @id @default(cuid())
  sellerId        String
  // Stable per-seller external key (raw.externalId from the connector) — the cache lookup key.
  externalKey     String
  sellerSku       String?
  sellerProductId String?
  // RawProduct snapshot at staging time, so the seller/admin UI can render the
  // original title/images without re-fetching from the connector.
  rawPayload      Json
  // 'auto_matched' | 'manual_matched' | 'pending_review' | 'escalated' | 'rejected'
  status          String      @default("pending_review")
  // Cache-hit target once matched (any path).
  productId       String?
  // 'auto' | 'seller_manual' | 'admin_existing' | 'admin_new_bgg' | 'admin_new_standalone' | 'legacy_unreviewed'
  matchMethod     String?
  matchConfidence Float?
  // Top candidate matches surfaced to seller/admin: [{ productId, name, score, bggId }]
  candidates      Json?
  listingId       String?     @unique
  sellerNote      String? // seller's note when escalating ("not found, please add")
  adminNote       String? // admin's note / rejection reason
  resolvedAt      DateTime?
  resolvedBy      String? // adminId, or 'seller:<sellerId>' for audit
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  seller          Seller      @relation(fields: [sellerId], references: [id])
  product         MktProduct? @relation(fields: [productId], references: [id])
  listing         Listing?    @relation(fields: [listingId], references: [id])

  @@unique([sellerId, externalKey])
  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([productId])
}

/// Per-listing promotional cashback — stacks on top of the seller's store-wide rate.
/// Buyer earns (storeCashbackPct + bonusCashbackPct) in store credits for this listing.
model ListingPromo {
  id               String    @id @default(cuid())
  listingId        String
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Additional store-credit % on top of the seller's global storeCashbackPct (0–0.50)
  bonusCashbackPct Float     @default(0)
  label            String? // e.g. "Promo semana del juego", shown in marketplace UI
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([listingId, active])
}

model DeliveryOption {
  id                 String   @id @default(cuid())
  listingId          String
  carrierId          String?
  name               String
  estimatedDaysMin   Int
  estimatedDaysMax   Int
  priceMinorUnits    Int // 0 = free
  freeThresholdMinor Int? // free shipping above this amount
  regions            String[] // province codes or 'MX' for nationwide
  // 'standard' | 'express' | 'pickup' | 'same_day'
  type               String   @default("standard")
  listing            Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
}

// ─── Marketplace Customers ────────────────────────────────────────────────────
model MktCustomer {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  name                  String?
  phone                 String?
  preferredRegion       String?
  preferredCurrency     String                 @default("MXN")
  passwordHash          String?
  emailVerified         Boolean                @default(false)
  verifyToken           String?                @unique
  authPrincipalId       String?                @unique
  authPrincipal         AuthPrincipal?         @relation(fields: [authPrincipalId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  orders                MarketplaceOrder[]
  addresses             MktAddress[]
  wallet                CustomerWallet?
  collections           UserCollection[]
  wishlists             Wishlist[]
  alerts                UserAlert[]
  availabilityRequests  ProductAvailabilityRequest[]
  recommendationProfile RecommendationProfile?
  shelfItems            ShelfItem[]
  xp                    CustomerXp?
}

model MktAddress {
  id         String      @id @default(cuid())
  customerId String
  label      String? // 'home' | 'work' | custom
  street     String
  city       String
  state      String
  postalCode String
  country    String      @default("MX")
  isDefault  Boolean     @default(false)
  customer   MktCustomer @relation(fields: [customerId], references: [id])
}

// ─── Orders ───────────────────────────────────────────────────────────────────
model MarketplaceOrder {
  id                     String                 @id @default(cuid())
  customerId             String?
  sellerId               String
  // pending | reserved | confirmed | shipped | delivered | cancelled | refunded
  status                 String                 @default("pending")
  currency               String                 @default("MXN")
  subtotalMinorUnits     Int
  shippingMinorUnits     Int                    @default(0)
  totalMinorUnits        Int
  commissionMinorUnits   Int                    @default(0)
  platformCashbackMinor  Int                    @default(0) // credited to buyer's platform wallet
  storeCashbackMinor     Int                    @default(0) // credited to buyer's store wallet
  platformCreditsApplied Int                    @default(0) // platform credits used at checkout
  storeCreditsApplied    Int                    @default(0) // store credits used at checkout
  reservationId          String? // seller-side hold ID
  reservationExpiresAt   DateTime?
  mpPreferenceId         String? // MercadoPago Checkout Pro preference id
  paymentId              String?
  paymentProvider        String?
  sellerOrderId          String? // order ID in seller's external system
  deliveryAddress        Json? // snapshot at order time
  // Manual payout tracking — stopgap while sellers can't connect their own MP
  // account for real-time split payments (see MpSellerOAuthService). The platform
  // collects 100% via its own account; admin marks here once the seller's net
  // payout (total - commission) has actually been transferred outside the platform.
  paidOutAt              DateTime?
  paidOutBy              String? // adminId or identifier of who recorded the payout
  events                 OrderEvent[]
  lines                  MarketplaceOrderLine[]
  seller                 Seller                 @relation(fields: [sellerId], references: [id])
  customer               MktCustomer?           @relation(fields: [customerId], references: [id])
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([sellerId, status])
  @@index([customerId])
  @@index([status, createdAt])
}

model MarketplaceOrderLine {
  id             String           @id @default(cuid())
  orderId        String
  listingId      String
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int
  order          MarketplaceOrder @relation(fields: [orderId], references: [id])
  listing        Listing          @relation(fields: [listingId], references: [id])
}

model OrderEvent {
  id        String           @id @default(cuid())
  orderId   String
  type      String // 'created' | 'reserved' | 'payment_captured' | 'confirmed' | etc.
  payload   Json?
  createdAt DateTime         @default(now())
  order     MarketplaceOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ─── Loyalty & Commissions ────────────────────────────────────────────────────

/// Singleton row (id = 'default') — platform-wide commission and cashback config.
model PlatformConfig {
  id                  String   @id @default("default")
  baseCommissionPct   Float    @default(0.05) // 5% — charged to seller on every sale
  minCommissionPct    Float    @default(0.02) // 2% floor — seller can never pay less
  platformCashbackPct Float    @default(0.01) // 1% — credited to buyer from platform revenue
  updatedAt           DateTime @updatedAt
}

/// Per-seller loyalty program config. Seller-funded cashback reduces their commission.
/// effectiveCommission = max(baseCommission - storeCashbackPct, minCommission)
model SellerRewardConfig {
  id               String   @id @default(cuid())
  sellerId         String   @unique
  seller           Seller   @relation(fields: [sellerId], references: [id])
  storeCashbackPct Float    @default(0) // 0–0.15 (0%–15%)
  updatedAt        DateTime @updatedAt
}

/// One wallet per customer. platformCreditsMinor usable on any seller.
model CustomerWallet {
  id                   String              @id @default(cuid())
  customerId           String              @unique
  customer             MktCustomer         @relation(fields: [customerId], references: [id])
  /// DEPRECATED: market-blind global balance. Superseded by MarketCredit, which
  /// carries the market and currency a credit is denominated in. Retained only
  /// so the pre-migration balance stays auditable; never write to it.
  platformCreditsMinor Int                 @default(0)
  updatedAt            DateTime            @updatedAt
  transactions         WalletTransaction[]
  storeCredits         StoreCredit[]
  marketCredits        MarketCredit[]
}

/// Store credits per customer×seller pair — only redeemable with that seller.
model StoreCredit {
  id           String         @id @default(cuid())
  walletId     String
  wallet       CustomerWallet @relation(fields: [walletId], references: [id])
  sellerId     String
  seller       Seller         @relation(fields: [sellerId], references: [id])
  /// Currency this credit is denominated in — a seller trades in one market.
  currency     String?        @db.Char(3)
  balanceMinor Int            @default(0)
  updatedAt    DateTime       @updatedAt

  @@unique([walletId, sellerId])
  @@index([walletId])
}

/// Append-only ledger for all wallet movements.
model WalletTransaction {
  id          String         @id @default(cuid())
  walletId    String
  wallet      CustomerWallet @relation(fields: [walletId], references: [id])
  /// earn_platform | redeem_platform | earn_store | redeem_store
  type        String
  amountMinor Int // positive = credit, negative = debit
  /// Market and currency this movement occurred in. Nullable only for rows
  /// written before credits were market-scoped.
  marketCode  String?
  currency    String?        @db.Char(3)
  sellerId    String?
  orderId     String?
  description String?
  createdAt   DateTime       @default(now())

  @@index([walletId, createdAt])
  @@index([orderId])
}

/// One shelf entry per customer×product — owned/wishlist/want-to-play/
/// previously-owned/for-trade/preordered. References MktProduct (the live
/// legacy catalog model apps/marketplace actually reads today), not the v2
/// CatalogProduct chain UserCollectionItem/WishlistItem point to, which is
/// unused by any API code as of this migration.
model ShelfItem {
  id         String      @id @default(cuid())
  customerId String
  customer   MktCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    MktProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status     String
  addedAt    DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([customerId, productId])
  @@index([customerId, status])
}

/// One XP total per customer. Events are the append-only audit trail;
/// totalXp is the denormalized running sum for fast reads (same pattern as
/// CustomerWallet.platformCreditsMinor next to WalletTransaction).
model CustomerXp {
  id         String      @id @default(cuid())
  customerId String      @unique
  customer   MktCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalXp    Int         @default(0)
  updatedAt  DateTime    @updatedAt
  events     XpEvent[]
}

/// Append-only XP ledger — mirrors WalletTransaction's role for credits.
model XpEvent {
  id           String     @id @default(cuid())
  customerXpId String
  customerXp   CustomerXp @relation(fields: [customerXpId], references: [id], onDelete: Cascade)
  label        String
  amount       Int
  createdAt    DateTime   @default(now())

  @@index([customerXpId, createdAt])
}

// ─── Connector sync health ────────────────────────────────────────────────────
model ConnectorSyncLog {
  id              String    @id @default(cuid())
  sellerId        String
  connectorType   String
  // 'catalog' | 'inventory' | 'prices' | 'orders'
  syncType        String
  // 'running' | 'success' | 'partial' | 'failed'
  status          String
  itemsSynced     Int       @default(0)
  itemsFailed     Int       @default(0)
  errors          Json?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  nextScheduledAt DateTime?
  seller          Seller    @relation(fields: [sellerId], references: [id])

  @@index([sellerId, syncType, startedAt])
  @@index([status, startedAt])
}

