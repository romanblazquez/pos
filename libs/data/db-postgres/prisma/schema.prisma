// Retail OS — central PostgreSQL schema (multi-tenant master data, reporting,
// sync ingestion, provider connections, terminal assignments, and onboarding).
//
// Multi-tenancy: every row is scoped by tenantId (row-level isolation now;
// schema-per-tenant or RLS policies are a roadmap hardening step).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────
model Tenant {
  id                  String               @id @default(cuid())
  name                String
  legalName           String?
  country             String               @default("MX")
  taxIdentifier       String?
  currency            String               @default("MXN")
  timezone            String               @default("America/Mexico_City")
  onboardingCompleted Boolean              @default(false)
  createdAt           DateTime             @default(now())
  stores              Store[]
  products            Product[]
  users               User[]
  providerConnections ProviderConnection[]
  terminalAssignments TerminalAssignment[]
  onboardingState     OnboardingState?
}

model Store {
  id                  String               @id @default(cuid())
  tenantId            String
  name                String
  address             String?
  storeType           String               @default("retail")
  currency            String               @default("MXN")
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  devices             Device[]
  sales               Sale[]
  terminalAssignments TerminalAssignment[]

  @@index([tenantId])
}

model Device {
  id           String   @id
  tenantId     String
  storeId      String
  label        String
  status       String   @default("pending") // pending | trusted | revoked
  publicKeyFp  String?
  registeredAt DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id])

  @@index([tenantId, storeId])
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String
  roles     String[] // cashier | supervisor | store_manager | admin
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
}

// ─── Catalog ──────────────────────────────────────────────────────────────────
model Product {
  id              String  @id @default(cuid())
  tenantId        String
  sku             String
  name            String
  barcode         String?
  category        String
  priceMinorUnits Int
  currency        String  @default("MXN")
  taxRatePercent  Float   @default(16)
  trackInventory  Boolean @default(true)
  active          Boolean @default(true)
  tenant          Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
}

// ─── Sales ────────────────────────────────────────────────────────────────────
model Sale {
  id              String     @id
  tenantId        String
  storeId         String
  deviceId        String
  customerId      String?
  status          String
  currency        String
  totalMinorUnits Int
  taxMinorUnits   Int
  snapshot        Json
  committedAt     DateTime
  ingestedAt      DateTime   @default(now())
  store           Store      @relation(fields: [storeId], references: [id])
  lines           SaleLine[]
  payments        Payment[]

  @@index([tenantId, storeId, committedAt])
}

model SaleLine {
  id              String @id @default(cuid())
  saleId          String
  productId       String
  name            String
  quantity        Float
  unitPriceMinor  Int
  discountMinor   Int    @default(0)
  taxRatePercent  Float
  lineTotalMinor  Int
  sale            Sale   @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model Payment {
  id              String               @id
  saleId          String
  tenantId        String
  provider        String
  method          String
  amountMinor     Int
  status          String
  providerRef     String?
  createdAt       DateTime             @default(now())
  sale            Sale                 @relation(fields: [saleId], references: [id])
  webhookEvents   PaymentWebhookEvent[]

  @@index([saleId])
  @@index([tenantId])
}

// ─── Payment providers ───────────────────────────────────────────────────────
/// OAuth and credential storage per merchant–provider pair.
/// Access tokens are stored encrypted; the plaintext never leaves the API process.
model ProviderConnection {
  id                   String   @id @default(cuid())
  tenantId             String
  provider             String   // 'mercadopago_point' | 'codi' | 'stripe_terminal' | …
  mode                 String   @default("production") // production | development
  status               String   @default("pending_oauth") // active | expired | error | pending_oauth | disconnected
  encryptedAccessToken String?
  encryptedRefreshToken String?
  tokenExpiresAt       DateTime?
  clientId             String?
  scope                String?
  providerAccountId    String?  // MP merchant_id after OAuth
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, mode])
  @@index([tenantId])
}

/// Maps a physical/virtual terminal to a store.
model TerminalAssignment {
  id            String   @id @default(cuid())
  tenantId      String
  storeId       String
  provider      String
  terminalId    String
  terminalName  String
  terminalModel String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  store         Store    @relation(fields: [storeId], references: [id])

  @@unique([tenantId, provider, terminalId])
  @@index([tenantId, storeId])
}

/// Append-only log of all inbound provider webhooks for audit and replay.
model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  tenantId        String
  provider        String
  providerEventId String?
  paymentId       String?
  rawPayload      Json
  processed       Boolean  @default(false)
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  payment         Payment? @relation(fields: [paymentId], references: [id])

  @@index([tenantId, provider])
  @@index([providerEventId])
}

// ─── Onboarding ───────────────────────────────────────────────────────────────
/// Persists onboarding wizard progress so it survives restarts and can be resumed.
model OnboardingState {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  currentStep    String
  completedSteps String[]
  data           Json
  startedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
}

// ─── Sync idempotency ─────────────────────────────────────────────────────────
/// Server-side idempotency ledger so re-delivered outbox messages are no-ops.
model IngestionKey {
  key        String   @id
  tenantId   String
  saleId     String
  receivedAt DateTime @default(now())
}
