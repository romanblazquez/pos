# ── Retail OS PostgreSQL (docker-compose.yml) ─────────────────────────────────
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail_os
POSTGRES_PORT=5432

# ── BGG catalog enrichment ───────────────────────────────────────────────────────
BGG_SCRAPER_PORT=3001
BGG_ENRICHER_HOST_PORT=3003
BGG_IMAGE_PUBLIC_BASE_URL=http://localhost:3001/images
BGG_DOWNLOAD_IMAGES=true
BGG_ENRICH_BATCH_SIZE=50
BGG_BATCH_DELAY_MIN_SECONDS=20
BGG_BATCH_DELAY_MAX_SECONDS=40
BGG_ITEM_DELAY_MS=1500
BGG_EMPTY_POLL_SECONDS=300
BGG_MAX_CONSECUTIVE_FAILURES=5
BGG_MAX_PRODUCT_ATTEMPTS=3
BGG_RETRY_DELAY_SECONDS=21600

# Unofficial Google Translate endpoint. Keep the batch endpoint and conservative
# request pacing; the service has no documented free quota or stability promise.
GOOGLE_TRANSLATE_ENABLED=true
GOOGLE_TRANSLATE_TARGET_ISO=es
GOOGLE_TRANSLATE_TARGET_LOCALE=es-MX
GOOGLE_TRANSLATE_MIN_DELAY_MS=3000
GOOGLE_TRANSLATE_JITTER_MS=1000
TRANSLATION_MODERATION_STATUS=NEEDS_REVIEW

# ── Odoo ERP Stack (docker-compose.odoo.yml) ──────────────────────────────────
ODOO_PORT=8069
ODOO_MASTER_PASSWORD=retail-master
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=odoo
ODOO_POSTGRES_ADMIN_DB=postgres
ODOO_DATABASE=odoo
ODOO_INIT_MODULES=base,web,base_setup,contacts,calendar,crm,sale_management,point_of_sale,stock,stock_account,purchase,account,project,hr,hr_attendance,hr_expense,hr_holidays,hr_recruitment,hr_skills,fleet,maintenance,mrp,repair,website,website_sale,website_blog,website_event,event,survey,mass_mailing,lunch
