# ── Retail OS PostgreSQL (docker-compose.yml) ─────────────────────────────────
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail_os
POSTGRES_PORT=5432

# ── Odoo ERP Stack (docker-compose.odoo.yml) ──────────────────────────────────
ODOO_PORT=8069
ODOO_MASTER_PASSWORD=retail-master
ODOO_POSTGRES_USER=odoo
ODOO_POSTGRES_PASSWORD=odoo
ODOO_POSTGRES_ADMIN_DB=postgres
ODOO_DATABASE=odoo
ODOO_INIT_MODULES=base,web,base_setup,contacts,calendar,crm,sale_management,point_of_sale,stock,stock_account,purchase,account,project,hr,hr_attendance,hr_expense,hr_holidays,hr_recruitment,hr_skills,fleet,maintenance,mrp,repair,website,website_sale,website_blog,website_event,event,survey,mass_mailing,lunch
