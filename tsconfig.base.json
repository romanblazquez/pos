{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@retail-os/shared-kernel": ["libs/domain/shared-kernel/src/index.ts"],
      "@retail-os/catalog": ["libs/domain/catalog/src/index.ts"],
      "@retail-os/inventory": ["libs/domain/inventory/src/index.ts"],
      "@retail-os/sales": ["libs/domain/sales/src/index.ts"],
      "@retail-os/customers": ["libs/domain/customers/src/index.ts"],
      "@retail-os/promotions": ["libs/domain/promotions/src/index.ts"],
      "@retail-os/payments-domain": ["libs/domain/payments/src/index.ts"],
      "@retail-os/rwp-core": ["libs/rwp/rwp-core/src/index.ts"],
      "@retail-os/rwp-bus": ["libs/rwp/rwp-bus/src/index.ts"],
      "@retail-os/rwp-electron-adapter": ["libs/rwp/rwp-electron-adapter/src/index.ts"],
      "@retail-os/saga": ["libs/platform/saga/src/index.ts"],
      "@retail-os/app-registry": ["libs/platform/app-registry/src/index.ts"],
      "@retail-os/workspace-engine": ["libs/platform/workspace-engine/src/index.ts"],
      "@retail-os/security": ["libs/platform/security/src/index.ts"],
      "@retail-os/payment-orchestrator": ["libs/payments/payment-orchestrator/src/index.ts"],
      "@retail-os/payments-contracts": ["libs/payments/contracts/src/index.ts"],
      "@retail-os/mercadopago-point": ["libs/payments/mercadopago-point/src/index.ts"],
      "@retail-os/mercadopago-point-emulator": ["libs/payments/mercadopago-point-emulator/src/index.ts"],
      "@retail-os/provider-mercadopago": ["libs/payments/provider-mercadopago/src/index.ts"],
      "@retail-os/provider-codi": ["libs/payments/provider-codi/src/index.ts"],
      "@retail-os/onboarding": ["libs/platform/onboarding/src/index.ts"],
      "@retail-os/provider-manager": ["libs/platform/provider-manager/src/index.ts"],
      "@retail-os/sync-engine": ["libs/sync/sync-engine/src/index.ts"],
      "@retail-os/local-db": ["libs/data/local-db/src/index.ts"],
      "@retail-os/db-postgres": ["libs/data/db-postgres/src/index.ts"],
      "@retail-os/shared-types": ["libs/shared/shared-types/src/index.ts"],
      "@retail-os/observability": ["libs/shared/observability/src/index.ts"],
      "@retail-os/api-client": ["libs/shared/api-client/src/index.ts"],
      "@retail-os/ui-react": ["libs/shared/ui-react/src/index.ts"],
      "@retail-os/ui-react/catalog-filter": ["libs/shared/ui-react/src/components/catalog-filter.tsx"],
      "@retail-os/erp-core": ["libs/erp/erp-core/src/index.ts"],
      "@retail-os/erp-platform": ["libs/erp/erp-platform/src/index.ts"],
      "@retail-os/odoo-bridge": ["libs/erp/odoo-bridge/src/index.ts"],
      "@retail-os/sellers": ["libs/domain/sellers/src/index.ts"],
      "@retail-os/listings": ["libs/domain/listings/src/index.ts"],
      "@retail-os/rankings": ["libs/domain/rankings/src/index.ts"],
      "@retail-os/connector-contracts": ["libs/connectors/connector-contracts/src/index.ts"],
      "@retail-os/tiendanube": ["libs/connectors/tiendanube/src/index.ts"],
      "@config/*": ["config/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules", "**/dist", "**/out", "**/.nx"]
}
