# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retail_os?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-a-long-random-string"
# Production uses RS256. Values may be PEM text (with \\n) or base64-encoded PEM.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_KEY_ID="2026-01"
# JSON object of old key IDs to public PEM/base64 PEM during zero-downtime rotation.
JWT_PREVIOUS_PUBLIC_KEYS="{}"
JWT_ISSUER="http://localhost:3000"

# ─── Google Identity Services ───────────────────────────────────────────────
# Use separate Web OAuth clients for the customer and admin trust boundaries.
GOOGLE_MARKETPLACE_CLIENT_ID=""
GOOGLE_ADMIN_CLIENT_ID=""
PLATFORM_ADMIN_EMAILS="matiasblazquez@gmail.com"

# ─── Connector credential encryption (AES-256-GCM) ───────────────────────────
# 32-byte key as 64 hex characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In dev, omitted = deterministic insecure dev key. MUST be set in production.
CREDENTIAL_ENCRYPTION_KEY=""

# ─── Typesense (search) ───────────────────────────────────────────────────────
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_API_KEY="xyz"

# ─── Redis (BullMQ queues) ────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_THROTTLE_ENABLED="false"

# ─── MercadoPago (marketplace checkout) ──────────────────────────────────────
# Get credentials from https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Seller MP OAuth callback — register this exact URL in your MP Marketplace app
MERCADOPAGO_REDIRECT_URI="http://localhost:3000/api/v1/payments/mp/oauth/callback"
# Secret for verifying incoming MP webhooks (from MP Developer → Your app → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=""

# ─── URLs ─────────────────────────────────────────────────────────────────────
# Where this API is publicly reachable (used for OAuth callback URLs)
API_BASE_URL="http://localhost:3000"
# Where the seller portal is running (OAuth success/error redirect target)
SELLER_PORTAL_URL="http://localhost:4400"

# ─── API server ───────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:4300,http://localhost:4400,http://localhost:4500"

# Set to 1 to enable dev-mode fallbacks (e.g. mock MP checkout when no token)
RETAIL_DEV_MODE="1"

# ─── Frontend env vars (Vite — prefix VITE_ is required) ─────────────────────
# Used by marketplace (apps/marketplace) and seller-portal (apps/seller-portal)
VITE_API_URL="http://localhost:3000"
VITE_SELLER_PORTAL_URL="http://localhost:4400"
VITE_GOOGLE_MARKETPLACE_CLIENT_ID=""
VITE_GOOGLE_ADMIN_CLIENT_ID=""

# Tiendanube signs webhook raw bodies with this application secret.
TIENDANUBE_CLIENT_ID=""
TIENDANUBE_CLIENT_SECRET=""

# ─── BGG discovery/import (apps/bgg-scraper + Steel) ─────────────────────────
BGG_SCRAPER_URL="http://localhost:3001"
BGG_USERNAME=""
BGG_PASSWORD=""
BGG_IMAGE_DIR="./data/bgg-images"
BGG_IMAGE_PUBLIC_BASE_URL="http://localhost:3001/images"
BGG_DOWNLOAD_IMAGES="true"

# Continuous BGG detail enrichment: 50 serial products, then 20-40s jitter.
BGG_ENRICH_BATCH_SIZE="50"
BGG_BATCH_DELAY_MIN_SECONDS="20"
BGG_BATCH_DELAY_MAX_SECONDS="40"
BGG_ITEM_DELAY_MS="1500"
BGG_EMPTY_POLL_SECONDS="300"
BGG_MAX_CONSECUTIVE_FAILURES="5"
BGG_MAX_PRODUCT_ATTEMPTS="3"
BGG_RETRY_DELAY_SECONDS="21600"
BGG_ENRICHER_STATE_DIR="./data/bgg-enricher"
BGG_ENRICHER_HEALTH_PORT="3002"

# Unofficial translate.google.com wrapper. Drafts default to NEEDS_REVIEW so
# machine output is not silently published; use APPROVED only by explicit choice.
GOOGLE_TRANSLATE_ENABLED="true"
GOOGLE_TRANSLATE_TARGET_ISO="es"
GOOGLE_TRANSLATE_TARGET_LOCALE="es-MX"
GOOGLE_TRANSLATE_MIN_DELAY_MS="3000"
GOOGLE_TRANSLATE_JITTER_MS="1000"
TRANSLATION_MODERATION_STATUS="NEEDS_REVIEW"

# ─── AI listing enrichment (seller-portal "Optimizar con IA", growth+ tier) ──
OPENAI_API_KEY=""

# ─── Odoo ERP (optional — desktop shell integration) ─────────────────────────
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
RETAIL_ODOO_URL=http://localhost:8069
RETAIL_ODOO_DATABASE=odoo
# RETAIL_ODOO_USER=admin
# RETAIL_ODOO_PASSWORD=admin
