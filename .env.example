# Retail OS — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# For local dev: matches docker-compose defaults.
# For Raspberry Pi production: change password and use Pi's LAN IP.
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail
POSTGRES_DB=retail_os
POSTGRES_PORT=5432

# Connection string consumed by Prisma (apps/api) and db:migrate scripts.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://retail:retail@localhost:5432/retail_os?schema=public

# For Raspberry Pi on your LAN (replace 192.168.x.x with Pi's IP):
# DATABASE_URL=postgresql://retail:YOUR_SECURE_PASSWORD@192.168.1.x:5432/retail_os?schema=public

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Mercado Pago ────────────────────────────────────────────────────────────
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# MP_WEBHOOK_SECRET=

# ─── Tiendanube ──────────────────────────────────────────────────────────────
# TN_APP_ID=
# TN_CLIENT_SECRET=

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-char random key for encrypting provider tokens at rest in PostgreSQL.
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=change_me_32_chars_exactly_here__
