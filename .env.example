# ── Odoo database (docker-compose.yml) ────────────────────────────────────────
# PostgreSQL credentials used by both the db and odoo containers.
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo

# ── Odoo web server ────────────────────────────────────────────────────────────
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# ── Retail OS shell ↔ Odoo connection ─────────────────────────────────────────
# These are set in the shell UI (Settings → Integraciones → Odoo ERP → Conectar).
# Listed here for reference / CI / scripted setups.
RETAIL_ODOO_URL=http://localhost:8069
RETAIL_ODOO_DATABASE=odoo
# RETAIL_ODOO_USER=admin
# RETAIL_ODOO_PASSWORD=admin
