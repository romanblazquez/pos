{
  "name": "desktop-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop-shell/src",
  "projectType": "application",
  "tags": ["type:app", "scope:shell"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "electron-vite dev --config apps/desktop-shell/electron.vite.config.mts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "electron-vite build --config apps/desktop-shell/electron.vite.config.mts" }
    }
  }
}
