{
  "name": "marketplace",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/marketplace/src",
  "projectType": "application",
  "tags": ["type:app", "scope:marketplace"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --config apps/marketplace/vite.config.mts" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "vite build --config apps/marketplace/vite.config.mts" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p tsconfig.json", "cwd": "apps/marketplace" }
    }
  }
}
